rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validPinLock(data) {
      return !('pin' in data)
        && data.updatedAt is int
        && (
          (
            data.keys().hasOnly(['skipped', 'updatedAt'])
            && data.skipped == true
          )
          || (
            data.keys().hasAll(['iterations', 'kdf', 'pinHash', 'pinSalt', 'updatedAt'])
            && !('skipped' in data)
            && data.kdf == 'pbkdf2-sha256'
            && data.iterations is int
            && data.iterations >= 100000
            && data.pinHash is string
            && data.pinHash.size() >= 32
            && data.pinHash.size() <= 128
            && data.pinSalt is string
            && data.pinSalt.size() >= 16
            && data.pinSalt.size() <= 64
          )
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.currency in ['VND', 'USD'];
      allow update, delete: if false;

      match /security/{docId} {
        allow read: if isOwner(userId) && docId == 'lock';
        allow create: if isOwner(userId) && docId == 'lock' && validPinLock(request.resource.data);
        allow update: if isOwner(userId) && docId == 'lock'
          && validPinLock(request.resource.data)
          && (!('pinHash' in resource.data) || 'pinHash' in request.resource.data);
        allow delete: if false;
      }

      match /{collection}/{docId} {
        allow read, write: if isOwner(userId) && collection != 'security';
      }
    }
  }
}
